# Copy to .env for local development. Never commit the filled-in .env.
# Every variable is optional; see src/courts_analyst/config.py for types.

# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── HTTP hardening (Phase 6; see SECURITY.md) ───────────────────────────────
# Comma-separated browser origins allowed by CORS; empty = none.
HTTP_ALLOWED_ORIGINS=
# Requests larger than this get 413.
HTTP_MAX_REQUEST_BYTES=1048576
# Per client (MCP session, else address); 0 disables.
HTTP_RATE_LIMIT_PER_MINUTE=120
# Set for any deployment reachable from the internet. /health stays open.
HTTP_BEARER_TOKEN=
# POST /api/ask per client per minute (each calls a paid model); 0 disables.
HTTP_ASK_RATE_LIMIT_PER_MINUTE=10

# ─── Data ─────────────────────────────────────────────────────────────────────
# Raw downloads go to $DATA_DIR/raw, build outputs to $DATA_DIR/build.
DATA_DIR=data
# Defaults to $DATA_DIR/build/courts.duckdb
# DUCKDB_PATH=
# Defaults to $DATA_DIR/build/idb.duckdb (civil IDB; party names go to
# $DATA_DIR/private/, which is never mounted into the server)
# IDB_DUCKDB_PATH=
# Keep cohort handles across restarts (a writable path outside data/build):
# COHORT_STORE_PATH=

# ─── Request desk (ADR 0013, sandbox) ─────────────────────────────────────────
# Where requests, inquiries and the library live (writable, outside
# data/build). Unset → in memory, emptied on restart.
# DESK_STORE_PATH=data/sandbox/desk.sqlite
# Turns on the staff side (the simulated statistics office) in the web app.
# Pick any long random string; the staff screen asks for it.
DESK_STAFF_TOKEN=
# Also offer the two staff tools over MCP (to play the office from a client).
# DESK_STAFF_MODE=false

# ─── External services ────────────────────────────────────────────────────────
# Agent models (P7/P10) and the CourtListener handoff (P7).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COURTLISTENER_API_TOKEN=

# ─── Agent (P7) ───────────────────────────────────────────────────────────────
# Model behind POST /api/ask: "anthropic:<model>" or "openai:<model>".
AGENT_MODEL=anthropic:claude-sonnet-5
# CourtListener docket lookups: auto (live with a token, else the cached
# fixture), fixture (never call out) or off.
AGENT_COURTLISTENER=auto
# Put question/answer/tool arguments in trace spans verbatim (debug only).
AGENT_TRACE_CONTENT=false
# Export agent spans to Phoenix (needs `uv sync --group otel`), for example
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_FORMAT: auto (JSON over HTTP, readable text on stdio) | json | pretty
LOG_LEVEL=INFO
LOG_FORMAT=auto
# Log tool arguments verbatim (needs LOG_LEVEL=DEBUG). Local debugging only.
LOG_TOOL_ARGUMENTS=false

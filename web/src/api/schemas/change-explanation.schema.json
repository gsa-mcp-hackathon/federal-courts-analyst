{
  "$defs": {
    "Caveat": {
      "description": "Something the reader must know to use the result correctly.",
      "properties": {
        "code": {
          "enum": [
            "small_cell",
            "suppressed",
            "data_break",
            "revised_figure",
            "period_mismatch",
            "inferred_not_official",
            "inexact_match",
            "out_of_scope",
            "mixed_editions",
            "partial_year",
            "truncated",
            "no_recommendation"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "caution",
          "enum": [
            "info",
            "caution",
            "block"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Warning",
      "type": "object"
    },
    "ChangeExplanation": {
      "description": "What changed, by how much, where, and what drove it.",
      "properties": {
        "measure": {
          "title": "Measure",
          "type": "string"
        },
        "measure_label": {
          "title": "Measure Label",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "court": {
          "title": "Court",
          "type": "string"
        },
        "court_name": {
          "title": "Court Name",
          "type": "string"
        },
        "period_from": {
          "title": "Period From",
          "type": "integer"
        },
        "period_to": {
          "title": "Period To",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "count",
            "per_judgeship"
          ],
          "title": "Mode",
          "type": "string"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "official_from": {
          "$ref": "#/$defs/FigureRef"
        },
        "official_to": {
          "$ref": "#/$defs/FigureRef"
        },
        "official_change": {
          "title": "Official Change",
          "type": "number"
        },
        "official_change_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Official Change Pct"
        },
        "idb_from": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idb From"
        },
        "idb_to": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idb To"
        },
        "idb_change": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The same change rebuilt from IDB records.",
          "title": "Idb Change"
        },
        "idb_change_excluding_mdl_direct": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The IDB change with directly filed MDL cases taken out (filings only).",
          "title": "Idb Change Excluding Mdl Direct"
        },
        "filings_effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part of the per-judgeship change due to filings.",
          "title": "Filings Effect"
        },
        "judgeship_effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part due to the change in authorized judgeships.",
          "title": "Judgeship Effect"
        },
        "decomposition_series": {
          "description": "Which data the breakdowns come from.",
          "title": "Decomposition Series",
          "type": "string"
        },
        "by_district": {
          "items": {
            "$ref": "#/$defs/Contribution"
          },
          "title": "By District",
          "type": "array"
        },
        "by_case_type": {
          "items": {
            "$ref": "#/$defs/Contribution"
          },
          "title": "By Case Type",
          "type": "array"
        },
        "by_district_and_case_type": {
          "items": {
            "$ref": "#/$defs/Contribution"
          },
          "title": "By District And Case Type",
          "type": "array"
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/Driver"
          },
          "title": "Drivers",
          "type": "array"
        }
      },
      "required": [
        "measure",
        "measure_label",
        "unit",
        "court",
        "court_name",
        "period_from",
        "period_to",
        "mode",
        "headline",
        "official_from",
        "official_to",
        "official_change",
        "official_change_pct",
        "decomposition_series"
      ],
      "title": "ChangeExplanation",
      "type": "object"
    },
    "Choice": {
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Clarification": {
      "description": "A question the server needs answered before it can give one figure.\n\nClients that support elicitation show it as a form; others get it in the\nresult. Either way, calling again with ``parameter`` set to a choice's\n``value`` answers it.",
      "properties": {
        "parameter": {
          "description": "The argument to set when calling again.",
          "title": "Parameter",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "title": "Choices",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the server would pick if it had to.",
          "title": "Default"
        }
      },
      "required": [
        "parameter",
        "question",
        "choices"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "Contribution": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value_from": {
          "title": "Value From",
          "type": "number"
        },
        "value_to": {
          "title": "Value To",
          "type": "number"
        },
        "change": {
          "title": "Change",
          "type": "number"
        },
        "share_of_change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "change / total change (can exceed 1 when others offset it).",
          "title": "Share Of Change"
        },
        "key_contributor": {
          "default": false,
          "title": "Key Contributor",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label",
        "value_from",
        "value_to",
        "change",
        "share_of_change"
      ],
      "title": "Contribution",
      "type": "object"
    },
    "Decline": {
      "description": "Why a guardrail policy withheld the answer, and what to ask instead.",
      "properties": {
        "reason": {
          "enum": [
            "judge_level",
            "pii",
            "small_cell",
            "policy",
            "advocacy"
          ],
          "title": "Reason",
          "type": "string"
        },
        "message": {
          "description": "The explanation to relay to the user.",
          "title": "Message",
          "type": "string"
        },
        "policy": {
          "description": "The rule that applies and where it comes from.",
          "title": "Policy",
          "type": "string"
        },
        "alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A question the server can answer instead.",
          "title": "Alternative"
        }
      },
      "required": [
        "reason",
        "message",
        "policy"
      ],
      "title": "Decline",
      "type": "object"
    },
    "Driver": {
      "properties": {
        "code": {
          "enum": [
            "mdl_direct_filed",
            "mdl_cases",
            "pandemic_window",
            "methodology_revision",
            "data_break",
            "judgeship_change"
          ],
          "title": "Code",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "basis": {
          "enum": [
            "official",
            "idb_derived",
            "inferred",
            "context"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude"
        },
        "share_of_change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share Of Change"
        }
      },
      "required": [
        "code",
        "title",
        "basis",
        "evidence"
      ],
      "title": "Driver",
      "type": "object"
    },
    "FigureRef": {
      "description": "One published value of a figure in one edition.",
      "properties": {
        "value": {
          "description": "The value as printed (rounded to the table's precision).",
          "title": "Value",
          "type": "number"
        },
        "edition": {
          "description": "Edition id, for example JB-2020 or JFF-2023.",
          "title": "Edition",
          "type": "string"
        },
        "table_code": {
          "description": "Table, for example X-1A or 6.2.",
          "title": "Table Code",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Published file the value was read from.",
          "title": "Url"
        },
        "cell_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sheet!cell (xlsx) or page/line (PDF) of the value.",
          "title": "Cell Ref"
        }
      },
      "required": [
        "value",
        "edition",
        "table_code"
      ],
      "title": "FigureRef",
      "type": "object"
    },
    "Period": {
      "description": "The 12-month period a figure covers.",
      "properties": {
        "fiscal_year": {
          "description": "Year the period ends in (FY2020 ends 2020).",
          "title": "Fiscal Year",
          "type": "integer"
        },
        "period_end": {
          "description": "Last day of the period.",
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_type": {
          "description": "'fiscal_year' (Oct 1\u2013Sep 30) or 'statistical_year' (Jul 1\u2013Jun 30, used for the 1990 rows).",
          "enum": [
            "fiscal_year",
            "statistical_year"
          ],
          "title": "Period Type",
          "type": "string"
        }
      },
      "required": [
        "fiscal_year",
        "period_end",
        "period_type"
      ],
      "title": "Period",
      "type": "object"
    },
    "Provenance": {
      "description": "Where a number came from and how far to trust it.",
      "properties": {
        "source": {
          "description": "'official_table' (printed in a uscourts.gov table), 'idb_derived' (computed from FJC IDB records) or 'derived' (computed from official figures).",
          "enum": [
            "official_table",
            "idb_derived",
            "derived"
          ],
          "title": "Source",
          "type": "string"
        },
        "table_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Code"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Publication series title.",
          "title": "Series"
        },
        "edition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edition"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "definition": {
          "description": "Plain-language definition of the measure.",
          "title": "Definition",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "cell_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Ref"
        },
        "revision_status": {
          "anyOf": [
            {
              "enum": [
                "only_edition",
                "original",
                "revised"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'only_edition' (published once), 'original' (republished unchanged) or 'revised' (a later edition printed a different value).",
          "title": "Revision Status"
        },
        "first_published": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "later_revisions": {
          "description": "Every later edition whose value differs from the one before it.",
          "items": {
            "$ref": "#/$defs/FigureRef"
          },
          "title": "Later Revisions",
          "type": "array"
        },
        "reconciliation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReconciliationBadge"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dataset_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IDB release the figure was computed from.",
          "title": "Dataset Release"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source",
        "definition"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReconciliationBadge": {
      "description": "How an IDB rebuild of a figure compares with the official table.",
      "properties": {
        "status": {
          "enum": [
            "matched",
            "explained_variance",
            "unexplained",
            "no_official_counterpart"
          ],
          "title": "Status",
          "type": "string"
        },
        "official_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Value"
        },
        "idb_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idb Value"
        },
        "variance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IDB minus official.",
          "title": "Variance"
        },
        "variance_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variance Pct"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        }
      },
      "required": [
        "status"
      ],
      "title": "ReconciliationBadge",
      "type": "object"
    }
  },
  "properties": {
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "needs_clarification",
        "declined"
      ],
      "title": "Status",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChangeExplanation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "declined": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Caveat"
      },
      "title": "Warnings",
      "type": "array"
    },
    "suggested_next": {
      "description": "Hints for a follow-up call.",
      "items": {
        "type": "string"
      },
      "title": "Suggested Next",
      "type": "array"
    }
  },
  "title": "Result[ChangeExplanation]",
  "type": "object"
}

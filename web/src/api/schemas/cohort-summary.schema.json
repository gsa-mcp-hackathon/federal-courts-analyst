{
  "$defs": {
    "Caveat": {
      "description": "Something the reader must know to use the result correctly.",
      "properties": {
        "code": {
          "enum": [
            "small_cell",
            "suppressed",
            "data_break",
            "revised_figure",
            "period_mismatch",
            "inferred_not_official",
            "inexact_match",
            "out_of_scope",
            "mixed_editions",
            "partial_year",
            "truncated"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "caution",
          "enum": [
            "info",
            "caution",
            "block"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Warning",
      "type": "object"
    },
    "Choice": {
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Clarification": {
      "description": "A question the server needs answered before it can give one figure.\n\nClients that support elicitation show it as a form; others get it in the\nresult. Either way, calling again with ``parameter`` set to a choice's\n``value`` answers it.",
      "properties": {
        "parameter": {
          "description": "The argument to set when calling again.",
          "title": "Parameter",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "title": "Choices",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the server would pick if it had to.",
          "title": "Default"
        }
      },
      "required": [
        "parameter",
        "question",
        "choices"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "CohortSummary": {
      "description": "A cohort's handle and a small preview: never rows, never names.",
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "spec": {
          "additionalProperties": true,
          "description": "The normalised filters.",
          "title": "Spec",
          "type": "object"
        },
        "basis": {
          "enum": [
            "filed",
            "terminated"
          ],
          "title": "Basis",
          "type": "string"
        },
        "n": {
          "description": "Cases (filed basis) or terminations (terminated basis).",
          "title": "N",
          "type": "integer"
        },
        "by_fiscal_year": {
          "items": {
            "$ref": "#/$defs/Count"
          },
          "title": "By Fiscal Year",
          "type": "array"
        },
        "top_courts": {
          "items": {
            "$ref": "#/$defs/Count"
          },
          "title": "Top Courts",
          "type": "array"
        },
        "top_nos_groups": {
          "items": {
            "$ref": "#/$defs/Count"
          },
          "title": "Top Nos Groups",
          "type": "array"
        },
        "mdl_direct_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mdl Direct Share"
        },
        "terminated_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of the cohort already terminated.",
          "title": "Terminated Share"
        }
      },
      "required": [
        "handle",
        "spec",
        "basis",
        "n",
        "by_fiscal_year",
        "top_courts",
        "top_nos_groups",
        "mdl_direct_share"
      ],
      "title": "CohortSummary",
      "type": "object"
    },
    "Count": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share"
        }
      },
      "required": [
        "key",
        "n"
      ],
      "title": "Count",
      "type": "object"
    },
    "FigureRef": {
      "description": "One published value of a figure in one edition.",
      "properties": {
        "value": {
          "description": "The value as printed (rounded to the table's precision).",
          "title": "Value",
          "type": "number"
        },
        "edition": {
          "description": "Edition id, for example JB-2020 or JFF-2023.",
          "title": "Edition",
          "type": "string"
        },
        "table_code": {
          "description": "Table, for example X-1A or 6.2.",
          "title": "Table Code",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Published file the value was read from.",
          "title": "Url"
        },
        "cell_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sheet!cell (xlsx) or page/line (PDF) of the value.",
          "title": "Cell Ref"
        }
      },
      "required": [
        "value",
        "edition",
        "table_code"
      ],
      "title": "FigureRef",
      "type": "object"
    },
    "Period": {
      "description": "The 12-month period a figure covers.",
      "properties": {
        "fiscal_year": {
          "description": "Year the period ends in (FY2020 ends 2020).",
          "title": "Fiscal Year",
          "type": "integer"
        },
        "period_end": {
          "description": "Last day of the period.",
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_type": {
          "description": "'fiscal_year' (Oct 1\u2013Sep 30) or 'statistical_year' (Jul 1\u2013Jun 30, used for the 1990 rows).",
          "enum": [
            "fiscal_year",
            "statistical_year"
          ],
          "title": "Period Type",
          "type": "string"
        }
      },
      "required": [
        "fiscal_year",
        "period_end",
        "period_type"
      ],
      "title": "Period",
      "type": "object"
    },
    "Provenance": {
      "description": "Where a number came from and how far to trust it.",
      "properties": {
        "source": {
          "description": "'official_table' (printed in a uscourts.gov table), 'idb_derived' (computed from FJC IDB records) or 'derived' (computed from official figures).",
          "enum": [
            "official_table",
            "idb_derived",
            "derived"
          ],
          "title": "Source",
          "type": "string"
        },
        "table_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Code"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Publication series title.",
          "title": "Series"
        },
        "edition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edition"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "definition": {
          "description": "Plain-language definition of the measure.",
          "title": "Definition",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "cell_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Ref"
        },
        "revision_status": {
          "anyOf": [
            {
              "enum": [
                "only_edition",
                "original",
                "revised"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'only_edition' (published once), 'original' (republished unchanged) or 'revised' (a later edition printed a different value).",
          "title": "Revision Status"
        },
        "first_published": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "later_revisions": {
          "description": "Every later edition whose value differs from the one before it.",
          "items": {
            "$ref": "#/$defs/FigureRef"
          },
          "title": "Later Revisions",
          "type": "array"
        },
        "reconciliation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReconciliationBadge"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dataset_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IDB release the figure was computed from.",
          "title": "Dataset Release"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source",
        "definition"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReconciliationBadge": {
      "description": "How an IDB rebuild of a figure compares with the official table.",
      "properties": {
        "status": {
          "enum": [
            "matched",
            "explained_variance",
            "unexplained",
            "no_official_counterpart"
          ],
          "title": "Status",
          "type": "string"
        },
        "official_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Value"
        },
        "idb_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idb Value"
        },
        "variance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IDB minus official.",
          "title": "Variance"
        },
        "variance_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variance Pct"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        }
      },
      "required": [
        "status"
      ],
      "title": "ReconciliationBadge",
      "type": "object"
    }
  },
  "properties": {
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "needs_clarification"
      ],
      "title": "Status",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/CohortSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "clarification": {
      "anyOf": [
        {
          "$ref": "#/$defs/Clarification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Caveat"
      },
      "title": "Warnings",
      "type": "array"
    },
    "suggested_next": {
      "description": "Hints for a follow-up call.",
      "items": {
        "type": "string"
      },
      "title": "Suggested Next",
      "type": "array"
    }
  },
  "title": "Result[CohortSummary]",
  "type": "object"
}

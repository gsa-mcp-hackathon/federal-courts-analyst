{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --host 127.0.0.1 --port 4174 --strictPort",
      "startServerReadyPattern": "4174",
      "url": [
        "http://127.0.0.1:4174/",
        "http://127.0.0.1:4174/dev/gallery",
        "http://127.0.0.1:4174/demo"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse" }
  }
}

Northern", "citation": "N.D. Tex.", "value": 388, "cell_ref": "Table X-1A!H37"}, {"rank": 7, "court": "MS-N", "court_name": "Mississippi, Northern", "citation": "N.D. Miss.", "value": 336, "cell_ref": "Table X-1A!H35"}, {"rank": 8, "court": "LA-W", "court_name": "Louisiana, Western", "citation": "W.D. La.", "value": 323, "cell_ref": "Table X-1A!H34"}, {"rank": 9, "court": "TX-S", "court_name": "Texas, Southern", "citation": "S.D. Tex.", "value": 322, "cell_ref": "Table X-1A!H39"}], "national": {"value": 431, "edition": "JB-2023", "table_code": "X-1A", "url": "https://www.uscourts.gov/sites/default/files/data_tables/jb_x1a_0930.2023.xlsx", "cell_ref": "Table X-1A!H5"}, "national_latest": {"value": 332, "edition": "JFF-2024", "table_code": "6.2", "url": "https://www.uscourts.gov/sites/default/files/document/jff_6.2_0930.2024.xlsx", "cell_ref": "Table 6.2!D6"}, "not_published": [], "total_courts": 9}, "clarification": null, "provenance": [{"source": "official_table", "table_code": "X-1A", "series": "Judicial Business of the United States Courts", "edition": "JB-2023", "period": {"fiscal_year": 2023, "period_end": "2023-09-30", "period_type": "fiscal_year"}, "definition": "Civil filings multiplied by Federal Judicial Center case weights (which reflect the relative judge time each case type needs), divided by authorized judgeships. The Judicial Conference uses weighted filings when assessing judgeship needs.", "url": "https://www.uscourts.gov/sites/default/files/data_tables/jb_x1a_0930.2023.xlsx", "cell_ref": null, "revision_status": null, "first_published": null, "later_revisions": [], "reconciliation": null, "dataset_release": null, "note": "All 9 values from JB-2023 Table X-1A."}], "warnings": [{"code": "revised_figure", "message": "Court values are only published in JB-2023. The national figure in that edition is 431; JFF-2024 later revised it to 332. Compare courts with the JB-2023 national figure, not the revised one.", "severity": "caution"}], "suggested_next": []
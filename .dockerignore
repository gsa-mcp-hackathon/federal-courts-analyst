# Keep the build context small and reproducible.
.git
.gitignore
.venv
venv
__pycache__/
*.pyc
*.pyo
*.pyd

.env
deploy/
eval/
tests/
.github/
.agents/

.ruff_cache/
.pytest_cache/
dist/
build/
*.egg-info/
plan/
docs/
web/node_modules/
data/raw/
data/private/
.mypy_cache/
*.md
!README.md

# GET /api/eval/runs reads the committed run summaries and records.
!eval/results/*.summary.json
!eval/results/*.jsonl

# Virtual environments
.venv/
venv/

# Environment variables (keep .env.example, never commit .env)
.env
deploy/**/.env
deploy/**/eval.env

# Deploy kit generated artifacts
deploy/ibm/local-mcp-toolkit/_stage/
deploy/ibm/local-mcp-toolkit/_snapshots/
deploy/ibm/local-mcp-toolkit/_toolkit.generated.yaml
deploy/**/eval-results/


# IBM Bob IDE directory (skills and MCP tool definition). The MCP server
# config is shared: it connects Bob to this server (docs/desk.md).
.bob/*
!.bob/mcp.json


# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Ruff
.ruff_cache/

# IDE / editor
.vscode/
.idea/
.zed/
*.swp

.mypy_cache/
coverage.xml

# Data: downloads and build outputs are never committed (see data/README.md)
data/raw/*
data/build/*
data/private/
!data/raw/.gitkeep
!data/build/.gitkeep
*.duckdb
*.duckdb.wal

# Frontend (P8)
web/node_modules/
web/dist/

# macOS
.DS_Store

# Eval runs (commit a run on purpose with `git add -f`, e.g. a phase baseline)
eval/results/*
!eval/results/README.md
data/sandbox/
eval/wxo/out/

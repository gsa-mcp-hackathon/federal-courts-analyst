# Virtual environments
.venv/
venv/

# Environment variables (keep .env.example, never commit .env)
.env
deploy/**/.env
deploy/**/eval.env

# Deploy kit generated artifacts
deploy/ibm/local-mcp-toolkit/_stage/
deploy/ibm/local-mcp-toolkit/_toolkit.generated.yaml
deploy/**/eval-results/


# IBM Bob IDE directory (skills and MCP tool definition)
.bob/


# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Ruff
.ruff_cache/

# IDE / editor
.vscode/
.idea/
.zed/
*.swp

.mypy_cache/
coverage.xml

# Data: downloads and build outputs are never committed (see data/README.md)
data/raw/*
data/build/*
!data/raw/.gitkeep
!data/build/.gitkeep
*.duckdb
*.duckdb.wal

# Frontend (P8)
web/node_modules/
web/dist/

# macOS
.DS_Store
